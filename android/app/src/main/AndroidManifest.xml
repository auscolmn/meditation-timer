<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Part 9: session audio. The service loops ambient sound while the
             screen is locked (mediaPlayback: it genuinely plays audio, and only
             for the session's duration); the receiver rings scheduled bells
             fired by exact wake-up alarms. Both are app-internal. -->
        <service
            android:name=".sessionaudio.SessionAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".sessionaudio.BellAlarmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Exact end-of-session notifications. Sati is a timer app, which is the
         acceptable core use case in Play policy for exact alarms. Without these,
         @capacitor/local-notifications silently falls back to inexact alarms on
         API 31+, and Doze can delay the "session complete" notification by
         minutes — precisely when the screen is locked and it matters most.
         USE_EXACT_ALARM (API 33+) is granted automatically; SCHEDULE_EXACT_ALARM
         covers Android 12/12L, where it is granted by default when declared. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Part 9: background session audio. The foreground service plays ambient
         sound while the screen is locked (type declaration mandatory on API
         34+); WAKE_LOCK keeps the CPU up for the ~16s a bell rings after an
         exact alarm wakes it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
</manifest>
